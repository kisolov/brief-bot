# Токен бота от @BotFather
TELEGRAM_TOKEN=
# Менеджерский чат. Для проверки на сервере только тестовый чат, не рабочий.
TELEGRAM_MANAGER_CHAT_ID=
# Код для первого входа: в боте команда `/editor <код>`
TELEGRAM_INVITE_CODE=
# false: запуск без опроса Telegram (тесты, e2e без токена)
TELEGRAM_POLLING_ENABLED=true

# Адрес редактора для ссылки из команды /editor.
# Локально http://localhost:3000, на сервере https://<ip-с-дефисами>.sslip.io
EDITOR_BASE_URL=http://localhost:3000

# Локальная разработка (docker-compose.yml): backend читает DSN и URL отсюда.
POSTGRES_DSN=postgresql://brief:brief@localhost:55432/brief
REDIS_URL=redis://localhost:56379/0

# Только для сервера (docker-compose.prod.yml). POSTGRES_DSN и REDIS_URL там
# compose собирает сам, в .env на сервере их задавать не нужно.
# Адрес сайта: <ip-с-дефисами>.sslip.io, например 203-0-113-10.sslip.io
SITE_ADDRESS=
# Пароль postgres: только латиница и цифры, например `openssl rand -hex 24`
POSTGRES_PASSWORD=
