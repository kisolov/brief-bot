#!/usr/bin/env bash
set -euo pipefail

root="$(git rev-parse --show-toplevel)"

cd "$root/backend"
uv run ruff check .
uv run pytest -m "not integration"

# Тесты редактора идут, только если в коммит попали его файлы
if git diff --cached --name-only | grep -q '^editor/'; then
  cd "$root/editor"
  npx vitest run
fi
